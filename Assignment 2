
# Temple Steps Problem - Q6 and Q7

calls = 0

# Normal Recursion
def ways_naive(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_naive(n-1) + ways_naive(n-2)


# Memoization
def ways_memo(n, cache=None):
    global calls

    if cache is None:
        cache = {}

    calls += 1

    if n <= 1:
        return 1

    if n not in cache:
        cache[n] = ways_memo(n-1, cache) + ways_memo(n-2, cache)

    return cache[n]


# Iterative Method
def ways_iterative(n):
    a, b = 1, 1

    for i in range(2, n+1):
        a, b = b, a+b

    return b


# Q6 (a): Call Tree
def call_tree(n, depth=0):
    print("  " * depth + "ways(" + str(n) + ")")

    if n <= 1:
        return

    call_tree(n-1, depth+1)
    call_tree(n-2, depth+1)


print("\nQ6 (a): CALL TREE")
call_tree(5)


# Q6 (b): Correctness Check
print("\nQ6 (b): CORRECTNESS CHECK")
print("n   Naive   Memo   Loop")

for n in range(1, 7):
    calls = 0
