# Generate random contacts
def generate_contacts(n, duplicate_ratio=0.3, seed=42):
    rng = random.Random(seed)

    first = ["Ravi", "Anita", "Karthik", "Meena",
             "Suresh", "Latha", "Arun", "Divya"]

    last = ["Kumar", "Sharma", "Iyer", "Nair",
            "Reddy", "Das", "Rao", "Menon"]

    formats = ["{}", "+91 {}", "+91{}", "0{}", "{} {}"]

    people = []
    contacts = []

    for _ in range(n):
        if people and rng.random() < duplicate_ratio:
            base = rng.choice(people)
        else:
            base = (rng.randint(6000000000, 9999999999),
                    f"{rng.choice(first)} {rng.choice(last)}")
            people.append(base)

        number = str(base[0])
        fmt = rng.choice(formats)

        if fmt.count("{}") == 2:
            shown = fmt.format(number[:5], number[5:])
        else:
            shown = fmt.format(number)

        name = rng.choice(["Dr. ", "", "Mr. "]) + base[1].lower()

        email = f"{base[1].split()[0].lower()}{base[0] % 97}@mail.com"

        contacts.append(Contact(name, [shown], [email]))

    return contacts


# Performance measurement
def timed(function, data):
    start = time.perf_counter()
    function(data)
    return time.perf_counter() - start


def measure():
    heading("Performance: Dictionary vs Pairwise")

    print("Contacts   Dictionary(s)   Pairwise(s)")

    for n in (1000, 10000):
        data = generate_contacts(n)

        dict_time = timed(merge_contacts, data)
        print(n, "      ", round(dict_time, 4), end="      ")

        if n == 1000:
            pair_time = timed(merge_contacts_pairwise, data)
            print(round(pair_time, 4))

            same = (canonical(merge_contacts(data)) ==
                    canonical(merge_contacts_pairwise(data)))

            print("Both methods give identical results:", same)
        else:
            print("Not run (too many pairwise comparisons)")


# Design defence
def defend():
    heading("Stage 4: Defend the Design")

    print("""
1. Dictionary uses O(1) average lookup.
2. Pairwise comparison uses O(n^2) time.
3. Same names with different numbers remain separate.
4. Missing phone and email cannot be matched.
5. Dictionary design is better for large contact lists.
""")


# Main function
def main():
    test_formats_and_duplicates()
    test_missing_fields()
    test_same_name()
    test_bridging()
    test_by_hand()
    measure()
    defend()


if __name__ == "__main__":
    main()

