# ------------------------------------------
# 5. FREQUENCY-BASED SUMMARISATION
# ------------------------------------------

def frequency_summary(text, sentence_count=2):

    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    words = clean_text(text).split()

    useful_words = [
        word for word in words
        if word not in STOPWORDS
    ]

    frequency = Counter(useful_words)

    sentence_scores = {}

    for sentence in sentences:
        sentence_words = clean_text(sentence).split()

        sentence_scores[sentence] = sum(
            frequency[word]
            for word in sentence_words
        )

    selected = sorted(
        sentence_scores,
        key=sentence_scores.get,
        reverse=True
    )

    return " ".join(selected[:sentence_count])


# ------------------------------------------
# 6. FIRST SENTENCE SUMMARISATION
# ------------------------------------------

def first_k_summary(text, sentence_count=2):

    sentences = re.split(r'(?<=[.!?])\s+', text.strip())

    return " ".join(sentences[:sentence_count])


# ------------------------------------------
# 7. SUMMARY COVERAGE
# ------------------------------------------

def summary_coverage(original, summary):

    original_words = set(clean_text(original).split())
    summary_words = set(clean_text(summary).split())

    if not original_words:
        return 0

    coverage = len(
        original_words.intersection(summary_words)
    ) / len(original_words)

    return round(coverage * 100, 2)


