def scorer_comparison():

    print("\n===== SCORER COMPARISON =====")

    agreement = 0

    for complaint in complaints:

        result1 = score(complaint)
        result2 = score_regex(complaint)

        if result1 == result2:
            agreement += 1

    percentage = agreement / len(complaints) * 100

    print("Total complaints:", len(complaints))
    print("Matching results:", agreement)
    print("Agreement percentage:", round(percentage, 2), "%")


