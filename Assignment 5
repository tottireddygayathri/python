# 1. SENTIMENT WORD LISTS
# ------------------------------------------

POSITIVE = {
    "good", "great", "excellent", "clean", "helpful",
    "fast", "improved", "happy", "polite", "smooth",
    "reliable", "safe", "patient", "better", "thank",
    "thanks", "well", "short"
}

NEGATIVE = {
    "bad", "dirty", "slow", "broken", "rude", "late",
    "smoke", "delay", "delays", "crowded", "wrong",
    "failed", "fails", "cold", "stink", "stinks",
    "ignored", "wet", "hard", "refuse", "extra", "garbage"
}

NEGATORS = {
    "not", "never", "no", "isn't", "wasn't",
    "aren't", "don't", "doesn't", "didn't"
}

STOPWORDS = {
    "the", "is", "a", "an", "and", "or", "to",
    "of", "in", "on", "was", "were", "are",
    "for", "with", "from", "it", "this", "that",
    "my", "we", "our", "they", "he", "she"
}


# ------------------------------------------
# 2. TEXT CLEANING
# ------------------------------------------

def clean_text(text):
    text = text.lower()
    text = re.sub(r"[^a-z\s']", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


# ------------------------------------------
# 3. SENTIMENT ANALYSIS
# ------------------------------------------

def _score_words(text):
    words = clean_text(text).split()
    score = 0

    for i, word in enumerate(words):

        if word in POSITIVE:
            value = 1
        elif word in NEGATIVE:
            value = -1
        else:
            value = 0

        if i > 0 and words[i - 1] in NEGATORS:
            value = -value

        score += value

    return score


def score(text):
    value = _score_words(text)

    if value > 0:
        return "positive"
    elif value < 0:
        return "negative"
    else:
        return "neutral"


def score_regex(text):
    text = clean_text(text)

    positive_count = sum(
        len(re.findall(r"\b" + word + r"\b", text))
        for word in POSITIVE
    )

    negative_count = sum(
        len(re.findall(r"\b" + word + r"\b", text))
        for word in NEGATIVE
    )

    value = positive_count - negative_count

    if value > 0:
        return "positive"
    elif value < 0:
        return "negative"
    else:
        return "neutral"


