# ------------------------------------------
# 12. DATABASE CREATION
# ------------------------------------------

def build_database():

    connection = sqlite3.connect(":memory:")

    cursor = connection.cursor()

    cursor.execute("""
        CREATE TABLE complaints (
            id INTEGER PRIMARY KEY,
            complaint TEXT,
            sentiment TEXT,
            department TEXT
        )
    """)

    departments = [
        "Bus Department",
        "Road Department",
        "Traffic Department"
    ]

    for i, complaint in enumerate(complaints):

        sentiment = score(complaint)

        department = departments[i % len(departments)]

        cursor.execute("""
            INSERT INTO complaints
            (complaint, sentiment, department)
            VALUES (?, ?, ?)
        """, (complaint, sentiment, department))

    connection.commit()

    return connection


# ------------------------------------------
# 13. DATABASE QUERY
# ------------------------------------------

def database_demo():

    print("\n===== DATABASE ANALYSIS =====")

    connection = build_database()

    cursor = connection.cursor()

    cursor.execute("""
        SELECT sentiment, COUNT(*)
        FROM complaints
        GROUP BY sentiment
    """)

    rows = cursor.fetchall()

    print("\nSentiment Counts:")

    for row in rows:
        print(row[0], ":", row[1])

    cursor.execute("""
        SELECT complaint
        FROM complaints
        WHERE sentiment = 'negative'
    """)

    print("\nNegative Complaints:")

    for row in cursor.fetchall():
        print("-", row[0])

    connection.close()


